    "# BLOQUE A — Integración y Preprocesamiento de Datos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Añadir el directorio src al path para poder importar los módulos\n",
    "sys.path.append(os.path.abspath(os.path.join('..', 'src')))\n",
    "\n",
    "from data.loader import leer_imagenes_idx, leer_etiquetas_idx, normalizar_y_guardar"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Carga de Datos Raw"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Rutas a los archivos IDX (asumiendo que están en data/raw)\n",
    "ruta_train_x = '../data/raw/train-images-idx3-ubyte'\n",
    "ruta_train_y = '../data/raw/train-labels-idx1-ubyte'\n",
    "ruta_test_x = '../data/raw/t10k-images-idx3-ubyte'\n",
    "ruta_test_y = '../data/raw/t10k-labels-idx1-ubyte'\n",
    "\n",
    "# Cargar los datos raw\n",
    "X_train_raw = leer_imagenes_idx(ruta_train_x)\n",
    "y_train_raw = leer_etiquetas_idx(ruta_train_y)\n",
    "X_test_raw = leer_imagenes_idx(ruta_test_x)\n",
    "y_test_raw = leer_etiquetas_idx(ruta_test_y)\n",
    "\n",
    "print(f\"Dimensiones de X_train_raw: {X_train_raw.shape}\")\n",
    "print(f\"Dimensiones de y_train_raw: {y_train_raw.shape}\")\n",
    "print(f\"Dimensiones de X_test_raw: {X_test_raw.shape}\")\n",
    "print(f\"Dimensiones de y_test_raw: {y_test_raw.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Preprocesamiento y Guardado"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Normalizar y guardar los datos procesados\n",
    "normalizar_y_guardar(X_train_raw, X_test_raw, y_train_raw, y_test_raw, out_dir=\"../data/processed/\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. EDA Mínimo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar los datos procesados para el EDA\n",
    "X_train = np.load('../data/processed/X_train.npy')\n",
    "y_train = pd.read_csv('../data/processed/y_train.csv')\n",
    "\n",
    "print(\"Value counts de las etiquetas de entrenamiento:\")\n",
    "print(y_train['label'].value_counts())\n",
    "\n",
    "# Visualizar algunas imágenes\n",
    "fig, axes = plt.subplots(2, 5, figsize=(10, 4))\n",
    "for i, ax in enumerate(axes.flat):\n",
    "    ax.imshow(X_train_raw[i], cmap='gray')\n",
    "    ax.set_title(f\"Clase: {y_train['label'][i]}\")\n",
    "    ax.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
